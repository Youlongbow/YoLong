{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yolong",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.ravenlong.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}
